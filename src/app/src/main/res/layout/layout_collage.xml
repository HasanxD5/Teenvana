<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gridLayoutCollage"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:columnCount="2"
    android:layout_marginTop="4dp"
    android:visibility="gone">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/collageImg1"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_gravity="fill"
        android:layout_columnWeight="1"
        android:scaleType="centerCrop"
        android:layout_margin="1dp"
        app:shapeAppearanceOverlay="@style/RoundedMedia"
        android:visibility="gone"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/collageImg2"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_gravity="fill"
        android:layout_columnWeight="1"
        android:scaleType="centerCrop"
        android:layout_margin="1dp"
        app:shapeAppearanceOverlay="@style/RoundedMedia"
        android:visibility="gone"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/collageImg3"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_gravity="fill"
        android:layout_columnWeight="1"
        android:scaleType="centerCrop"
        android:layout_margin="1dp"
        app:shapeAppearanceOverlay="@style/RoundedMedia"
        android:visibility="gone"/>

    <FrameLayout
        android:id="@+id/collageImg4Container"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_gravity="fill"
        android:layout_columnWeight="1"
        android:layout_margin="1dp"
        android:visibility="gone">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/collageImg4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedMedia"/>

        <TextView
            android:id="@+id/textViewMore"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"/>
    </FrameLayout>

</GridLayout>